# ===========================================
# X Growth Engine — Environment Variables
# ===========================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file with real secrets.

# --- Database (Neon PostgreSQL) ---
# Get from https://console.neon.tech → Connection Details → use the POOLED connection string
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Authentication ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-random-secret-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# --- Gemini AI (Milestone 4) ---
# Get from https://aistudio.google.com/apikey
# Model: gemini-2.0-flash | Max output tokens: 2048 | Temperature: 0.8
# Server-side only — never prefix with NEXT_PUBLIC_
# GEMINI_API_KEY="your-gemini-api-key"

# --- X (Twitter) API (Milestone 5) ---
# X_CLIENT_ID="your-x-oauth2-client-id"
# X_CLIENT_SECRET="your-x-oauth2-client-secret"

# --- n8n Automation (Milestone 6) ---
# Base URL of your n8n instance (HTTPS required in production)
# N8N_BASE_URL="https://your-n8n-instance.com"
# Shared secret for HMAC webhook signatures — generate with: openssl rand -base64 32
# Configure the same secret in n8n webhook nodes for verification
# Server-side only — never prefix with NEXT_PUBLIC_
# N8N_WEBHOOK_SECRET="generate-with-openssl-rand-base64-32"
